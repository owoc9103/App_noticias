library(dplyr)
library(ggplot2)
# ------------------------------------------------------------
# ANÁLISIS DESCRIPTIVO Y ESTIMACIÓN DE ELASTICIDAD PRECIO-DEMANDA
# ------------------------------------------------------------
# Librerías necesarias
library(dplyr)
library(ggplot2)
library(readr)
library(broom)
# ------------------------------------------------------------
# ANÁLISIS DESCRIPTIVO Y ESTIMACIÓN DE ELASTICIDAD PRECIO-DEMANDA
# ------------------------------------------------------------
# Librerías necesarias
library(dplyr)
library(ggplot2)
library(readr)
library(broom)
