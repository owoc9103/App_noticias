# Cargar utilidades del script base (no ejecuta main() al hacer source)
DIR_SCRIPT <- if (exists("DIR_SCRIPT") && nzchar(DIR_SCRIPT)) {
DIR_SCRIPT
} else {
args_run <- commandArgs(trailingOnly = FALSE)
file_arg <- grep("^--file=", args_run, value = TRUE)
if (length(file_arg)) {
dirname(normalizePath(sub("^--file=", "", file_arg[1]), winslash = "/"))
} else {
getwd()
}
}
source(file.path(DIR_SCRIPT, "cotizacion_datalab_puj.R"), local = FALSE)
